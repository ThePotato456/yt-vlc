# Create a Discord application and paste its bot token here.
DISCORD_BOT_TOKEN=

# Optional when the bot belongs to one server; required to select among multiple.
DISCORD_GUILD_ID=

# Optional: restrict !play requests to one text channel.
DISCORD_REQUEST_CHANNEL_ID=

# Optional logging settings. Set DISCORD_LOG_FILE=off for console-only logs.
DISCORD_LOG_LEVEL=INFO
DISCORD_LOG_FILE=logs/discord_bot.log

# VLC audio module used by Discord application-audio capture on Windows.
# Options: directsound, waveout, mmdevice, automatic
VLC_AUDIO_OUTPUT=mmdevice

# Active Windows output endpoint used by mmdevice. A complete friendly name or
# MMDevice endpoint ID is accepted. The bot stops with an error if it cannot
# resolve this device, preventing accidental playback through default speakers.
VLC_AUDIO_DEVICE=CABLE Input
